{
  "name": "tellerwerk-marketplace",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @app/web dev",
    "build": "pnpm -r build",
